# Kaydet server configuration — copy to `.env` (never commit `.env`).
# Every value below is a safe placeholder; there are NO real secrets in this file.
# Full documentation of each security setting: apps/server/SECURITY.md

# development | test | production
NODE_ENV=development

HOST=127.0.0.1
PORT=3001

# Path prefix of the API contract (`/session`, `/accounts`, …). `/health` and `/ready` stay at the root.
API_PREFIX=/api

# trace | debug | info | warn | error | fatal | silent   (default: info; silent under NODE_ENV=test)
LOG_LEVEL=info

# Comma-separated list of exact browser origins allowed to call the API (no wildcard).
# Used for BOTH CORS and the CSRF origin check.
# Development default: the local Vite client. REQUIRED in production (https only).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Sessions ──────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=kaydet_session
# lax | strict   (never "none")
SESSION_COOKIE_SAMESITE=lax
# Hard upper bound of a session's life (default 7 days) and inactivity limit (default 8 hours).
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=28800
# lastSeenAt is written at most this often.
SESSION_TOUCH_INTERVAL_SECONDS=60

# ── Passwords (policy for NEW passwords; login only bounds the input length) ─
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=256

# ── Sign-in throttling (temporary exponential back-off; never a permanent lock-out) ─
LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LOGIN_MAX_FAILURES_PER_ADDRESS=20
LOGIN_BACKOFF_BASE_SECONDS=30
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900

# ── Mail-credential encryption keys (SECRET) ──────────────────────────────
# Format: "<id>:<base64 of 32 random bytes>" — several entries separated by commas (old keys stay so old records can
# still be read while they are re-encrypted; see "Key rotation" in SECURITY.md).
# REQUIRED in production: the server refuses to start without it. Outside production, when unset, the server uses a
# throw-away in-process key (stored credentials then do not survive a restart) and logs a warning.
# Generate a key:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# NEVER commit real keys; inject them from your secret manager / deployment environment.
# CREDENTIAL_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# Which key encrypts NEW data (required when several keys are listed; defaults to the only one).
# CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=k1

# ── Database (SQLite) ─────────────────────────────────────────────────────
# Path of the SQLite file. REQUIRED in production and must be ABSOLUTE, on persistent storage (see DATABASE.md "Backup").
# The server never creates the directory in production and refuses a file that is not a Kaydet database.
# Development default when unset: ./data/kaydet.db (relative to the working directory; created automatically).
# ":memory:" is allowed outside production only. NEVER commit database files (*.db, *-wal, *-shm are git-ignored).
# DATABASE_PATH=/var/lib/kaydet/kaydet.db
# How long a statement waits for another process's write lock before failing with a retryable error (ms).
DATABASE_BUSY_TIMEOUT_MS=5000

# ── Request/upload limits (bytes) ─────────────────────────────────────────
MAX_JSON_BODY_BYTES=1048576
MAX_DRAFT_BODY_BYTES=16777216
# MAX_UPLOAD_FILE_BYTES defaults to the domain contract value (25 MiB); MAX_UPLOAD_TOTAL_BYTES to 50 MiB.
# MAX_UPLOAD_FILE_BYTES=26214400
# MAX_UPLOAD_TOTAL_BYTES=52428800

REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# Set to true only behind a trusted reverse proxy (client address for throttling comes from X-Forwarded-For).
TRUST_PROXY=false
